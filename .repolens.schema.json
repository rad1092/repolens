{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rad1092/repolens/raw/main/.repolens.schema.json",
  "title": "RepoLens configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema"
  ],
  "properties": {
    "schema": {
      "const": 2
    },
    "excludes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      },
      "uniqueItems": true
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "failOn": {
          "enum": [
            "none",
            "critical",
            "warning",
            "new-critical",
            "new-warning"
          ]
        },
        "strict": {
          "type": "boolean"
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workflow/syntax": {
          "$ref": "#/$defs/check"
        },
        "workflow/pull-request-trigger": {
          "$ref": "#/$defs/check"
        },
        "workflow/permissions": {
          "$ref": "#/$defs/check"
        },
        "workflow/action-pin": {
          "$ref": "#/$defs/check"
        },
        "workflow/script-wiring": {
          "$ref": "#/$defs/check"
        },
        "dependabot/syntax": {
          "$ref": "#/$defs/check"
        },
        "dependabot/npm-coverage": {
          "$ref": "#/$defs/check"
        },
        "dependabot/actions-coverage": {
          "$ref": "#/$defs/check"
        },
        "node/package-json": {
          "$ref": "#/$defs/check"
        },
        "node/lockfile-syntax": {
          "$ref": "#/$defs/check"
        },
        "node/lockfile-sync": {
          "$ref": "#/$defs/check"
        },
        "node/script-contract": {
          "$ref": "#/$defs/check"
        },
        "repository/tracked-env": {
          "$ref": "#/$defs/check"
        },
        "npm/update-available": {
          "$ref": "#/$defs/check"
        },
        "coverage/npm": {
          "$ref": "#/$defs/check"
        },
        "config/ignore-expired": {
          "$ref": "#/$defs/check"
        }
      }
    }
  },
  "$defs": {
    "expiration": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])[Tt](?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:[Zz]|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$"
    },
    "reason": {
      "type": "string",
      "minLength": 8
    },
    "ignore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fingerprint",
        "reason",
        "expiresAt"
      ],
      "properties": {
        "fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reason": {
          "$ref": "#/$defs/reason"
        },
        "expiresAt": {
          "$ref": "#/$defs/expiration"
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "critical"
          ]
        },
        "reason": {
          "$ref": "#/$defs/reason"
        },
        "expiresAt": {
          "$ref": "#/$defs/expiration"
        },
        "ignore": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ignore"
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": false
              }
            },
            "required": [
              "enabled"
            ]
          },
          "then": {
            "allOf": [
              {
                "required": [
                  "reason",
                  "expiresAt"
                ]
              },
              {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "severity"
                      ]
                    },
                    {
                      "required": [
                        "ignore"
                      ]
                    }
                  ]
                }
              }
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "reason"
                  ]
                },
                {
                  "required": [
                    "expiresAt"
                  ]
                }
              ]
            }
          }
        }
      ]
    }
  }
}
