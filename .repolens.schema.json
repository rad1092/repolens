{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rad1092/repolens/raw/main/.repolens.schema.json",
  "title": "RepoLens configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "excludes",
    "staleDays",
    "largeFileMB",
    "policy"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "excludes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      },
      "uniqueItems": true
    },
    "staleDays": {
      "type": "integer",
      "minimum": 1
    },
    "largeFileMB": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "failOn",
        "strict"
      ],
      "properties": {
        "failOn": {
          "enum": [
            "none",
            "critical",
            "warning",
            "new-critical",
            "new-warning"
          ]
        },
        "strict": {
          "type": "boolean"
        }
      }
    }
  }
}
