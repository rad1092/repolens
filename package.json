{
  "name": "repolens",
  "version": "0.1.0",
  "description": "Read-only repository health audits for local and GitHub repositories.",
  "type": "module",
  "bin": {
    "repolens": "./dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "npm run build && node --test dist/test/*.test.js",
    "check": "npm run clean && npm run test && npm run lint",
    "lint": "tsc -p tsconfig.json --noEmit",
    "example": "npm run build && node dist/src/cli.js test/fixtures/example --format html --output examples/index.html --offline"
  },
  "keywords": [
    "repository",
    "maintenance",
    "audit",
    "cli",
    "github"
  ],
  "license": "MIT",
  "dependencies": {
    "semver": "^7.7.2"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/semver": "^7.7.1",
    "typescript": "^5.9.2"
  }
}
