{
  "name": "@rad1092/repolens",
  "version": "0.4.0",
  "description": "Read-only Node and GitHub maintenance regression gate as a CLI and GitHub Action.",
  "type": "module",
  "bin": {
    "repolens": "./dist/src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    ".repolens.schema.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:action": "esbuild src/action.ts --bundle --platform=node --target=node24 --format=cjs --outfile=action/index.cjs --legal-comments=none",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "npm run build && node --test dist/test/*.test.js",
    "check": "npm run clean && npm run test && npm run lint && npm run build:action && npm run verify:package",
    "ci": "npm run check && git diff --exit-code -- action/index.cjs",
    "lint": "tsc -p tsconfig.json --noEmit",
    "example": "npm run build && node dist/src/cli.js scan test/fixtures/example --format html --output repolens-report.html --offline",
    "verify:package": "node scripts/verify-package.mjs",
    "release:artifacts": "node scripts/release-artifacts.mjs",
    "prepack": "npm run clean && npm run build"
  },
  "keywords": [
    "repository",
    "maintenance",
    "audit",
    "cli",
    "github"
  ],
  "license": "MIT",
  "homepage": "https://repolens.whago.net/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rad1092/repolens.git"
  },
  "bugs": {
    "url": "https://github.com/rad1092/repolens/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "minimatch": "^10.2.6",
    "semver": "^7.8.5",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/semver": "^7.8.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
